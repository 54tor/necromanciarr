# Secrets et accès de Necromanciarr. Copier ce fichier en `.env` et remplir les valeurs.
# `.env` est ignoré par git : ne jamais le commiter.

# URL de base du fournisseur de bibliothèque (non secret). Lue à partir de la tâche 4c.
# Les routes du contrat sont servies en dessous (docs/contract/openapi.yaml).
LIBRARY_API=

# Jeton Bearer du fournisseur de bibliothèque.
LIBRARY_PROVIDER_TOKEN=

# Clés API Radarr/Sonarr, séparées par des virgules, dans le même ordre que `arr_instances` de la configuration.
ARR_API_KEYS=

# Mot de passe de l'interface web de qBittorrent (l'utilisateur et l'URL sont dans la configuration).
QBIT_PASSWORD=

# Jeton d'accès à l'interface web de Necromanciarr. Obligatoire dès que l'écoute n'est pas en loopback.
NECROMANCIARR_AUTH_TOKEN=
