# Secrets et accès de Necromanciarr. Copier ce fichier en `.env` et remplir les valeurs.
# `.env` est ignoré par git : ne jamais le commiter. Ces variables alimentent les ${NOM} de config.json.

# URL de base du fournisseur de bibliothèque (non secret) ; surcharge `libraryApi` de config.json.
LIBRARY_API=

# Jeton Bearer du fournisseur de bibliothèque.
LIBRARY_PROVIDER_TOKEN=

# Clé d'API Radarr, référencée par `radarr` dans config.json (?apikey=${RADARR_API_KEY}).
RADARR_API_KEY=

# Clé d'API Sonarr, référencée par `sonarr` dans config.json (?apikey=${SONARR_API_KEY}).
SONARR_API_KEY=

# Mot de passe de l'interface web de qBittorrent, référencé par `torrentClients` dans config.json.
# Encoder en pourcent les caractères réservés d'une URL (@, :, /, #, ?).
QBIT_PASSWORD=

# Jeton d'accès à l'interface web de Necromanciarr. Obligatoire dès que l'écoute n'est pas en loopback.
NECROMANCIARR_AUTH_TOKEN=

# Mot de passe de l'API de contrôle à distance de rclone, référencé par `rclone.rc` dans config.json
# (http://utilisateur:${RCLONE_RC_PASS}@hôte:5572). Le processus rclone qui porte le montage doit être lancé avec
# `--rc --rc-addr :5572 --rc-user <utilisateur> --rc-pass <motdepasse>`. Exposer rc hors d'un réseau privé est
# dangereux : n'importe qui qui l'atteint pilote rclone. Encoder en pourcent les caractères réservés d'une URL (@, :, /, #, ?)
# du mot de passe. Laisser vide sans rc.
RCLONE_RC_PASS=
