# Secrets et accès de Necromanciarr. Copier ce fichier en `.env` et remplir les valeurs.
# `.env` est ignoré par git : ne jamais le commiter. Ces variables alimentent les ${NOM} de config.json.

# URL de base du fournisseur de bibliothèque (non secret) ; surcharge `libraryApi` de config.json.
LIBRARY_API=

# Jeton Bearer du fournisseur de bibliothèque.
LIBRARY_PROVIDER_TOKEN=

# Clé d'API Radarr, référencée par `radarr` dans config.json (?apikey=${RADARR_API_KEY}).
RADARR_API_KEY=

# Clé d'API Sonarr, référencée par `sonarr` dans config.json (?apikey=${SONARR_API_KEY}).
SONARR_API_KEY=

# Mot de passe de l'interface web de qBittorrent, référencé par `torrentClients` dans config.json.
# Encoder en pourcent les caractères réservés d'une URL (@, :, /, #, ?).
QBIT_PASSWORD=

# Jeton d'accès à l'interface web de Necromanciarr. Obligatoire dès que l'écoute n'est pas en loopback.
NECROMANCIARR_AUTH_TOKEN=

# Mot de passe de l'API de contrôle à distance de rclone, référencé par `rc` d'un fournisseur `fsProviders` de type rclone
# (http://utilisateur:${RCLONE_RC_PASS}@hôte:5572). Le processus rclone qui porte le montage doit être lancé avec
# `--rc --rc-addr :5572 --rc-user <utilisateur> --rc-pass <motdepasse>`. Exposer rc hors d'un réseau privé est
# dangereux : n'importe qui qui l'atteint pilote rclone. Encoder en pourcent les caractères réservés d'une URL (@, :, /, #, ?)
# du mot de passe. Laisser vide sans rc.
RCLONE_RC_PASS=

# Chemin du config.js de cross-seed (facultatif) ; surcharge `crossSeedConfig` de config.json, et --cross-seed-config
# surcharge les deux. Ses radarr, sonarr, torrentClients, linkDirs, linkType, skipRecheck, linkCategory, host, port et
# apiKey servent de défauts sous config.json ; une liste non vide de config.json remplace la liste importée en entier.
# Les process.env.NOM du fichier sont résolus ici aussi (environnement réel puis .env). Vide : cross-seed non configuré.
CROSS_SEED_CONFIG=

# Clé d'API du démon cross-seed, à référencer par `crossSeed` dans config.json quand le host du config.js ne
# convient pas (en Docker, son localhost désigne le conteneur de cross-seed) :
# "crossSeed": "http://cross-seed:2468?apikey=${CROSS_SEED_API_KEY}"
# CROSS_SEED_API_KEY=

# Rôle de cross-seed (facultatif) ; surcharge `crossSeedMode` de config.json, et --cross-seed-mode surcharge les deux.
# auto (défaut) : cross-seed est notifié s'il est configuré et joignable, sinon Necromanciarr cherche lui-même ;
# delegate : cross-seed obligatoire, sans lui aucune recherche de correspondance (avertissement) ;
# native : Necromanciarr cherche lui-même, cross-seed est ignoré ; off : aucune recherche de correspondance.
CROSS_SEED_MODE=
